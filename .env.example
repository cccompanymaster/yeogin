# ── 필수 ────────────────────────────────────────────────
# SQLite 파일 경로 (로컬 개발 기본값)
DATABASE_URL="file:./dev.db"

# JWT 세션 서명 키. 운영 환경에서는 반드시 임의의 긴 문자열로 교체하세요.
SESSION_SECRET="yeogin-dev-secret-change-me"

# ── 선택 ────────────────────────────────────────────────
# 사이트 절대 URL (sitemap.xml, JSON-LD, OG 이미지에 사용)
SITE_URL="http://localhost:3000"

# 관리자 페이지(/admin) 접근 허용 이메일 (콤마 구분)
ADMIN_EMAILS="admin@yeogin.kr"

# 유튜브 구독자 자동 인증. 미설정 시 수동 입력 방식으로 동작합니다.
YOUTUBE_API_KEY=""

# 소셜 로그인 (카카오/네이버). 미설정 시 로그인 화면에서 버튼이 숨겨집니다.
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
OAUTH_REDIRECT_BASE="http://localhost:3000"
