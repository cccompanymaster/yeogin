generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 사용자(체험단 신청자) - 일반 회원
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String
  phone        String?
  blogUrl      String?
  instaUrl     String?
  youtubeUrl   String?
  region       String?
  trustGrade   String   @default("BRONZE") // BRONZE/SILVER/GOLD/PLATINUM/DIAMOND
  point        Int      @default(0)
  createdAt    DateTime @default(now())

  applications Application[]
  reviews      Review[]
  penalties    Penalty[]
}

// 광고주 회원
model Advertiser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  companyName  String
  bizNumber    String
  contactName  String
  phone        String
  createdAt    DateTime @default(now())

  campaigns Campaign[]
}

// 캠페인
model Campaign {
  id            String   @id @default(cuid())
  advertiserId  String
  advertiser    Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  title         String
  description   String     // 풍부한 설명 (마크다운/줄바꿈)
  thumbnail     String     // URL
  type          String     // VISIT, DELIVERY, PURCHASE, REPORTER
  channel       String     // BLOG, INSTA, YOUTUBE, SHORTS, CLIP
  category      String     // 맛집, 카페, 뷰티, 패션, 식품, 생활, 디지털, 여행, 육아
  region        String?    // 서울 강남구 등 (방문형일 때)
  address       String?

  offer         String     // 제공 내역 텍스트 (예: 10만원 상당 코스 요리)
  offerValue    Int        // 제공 가치 금액(원)
  capacity      Int        // 모집 인원
  appliedCount  Int        @default(0)

  applyStart    DateTime
  applyEnd      DateTime
  announceAt    DateTime
  reviewStart   DateTime
  reviewEnd     DateTime

  guide         String     // 미션/가이드 텍스트
  keywords      String     // 필수 키워드 (콤마)
  status        String     @default("OPEN") // OPEN, CLOSED, COMPLETED
  fastMatch     Boolean    @default(false)

  createdAt     DateTime   @default(now())

  applications  Application[]
  reviews       Review[]
}

// 신청 내역
model Application {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelUrl  String   // 신청자가 활동할 채널 URL
  message     String?  // 자기소개/어필
  status      String   @default("PENDING") // PENDING, SELECTED, REJECTED, COMPLETED, CANCELED
  createdAt   DateTime @default(now())

  review      Review?
  @@unique([campaignId, userId])
}

// 리뷰
model Review {
  id            String   @id @default(cuid())
  applicationId String   @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  url           String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason  String?
  createdAt     DateTime @default(now())
}

// 패널티
model Penalty {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // CANCEL_AFTER_SELECT, NO_REVIEW, BAD_REVIEW
  reason    String
  point     Int      // 차감 포인트
  createdAt DateTime @default(now())
}
