generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 사용자(체험단 신청자) - 일반 회원
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String
  phone        String?
  blogUrl      String?
  instaUrl     String?
  youtubeUrl   String?
  tiktokUrl    String?
  region       String?
  bio          String?  // 한 줄 소개
  avatarUrl    String?  // data URL (base64) 또는 외부 URL

  // SNS 지표
  blogVisitors       Int?
  blogVerifiedAt     DateTime?
  instaFollowers     Int?
  instaVerifiedAt    DateTime?
  youtubeSubscribers Int?
  youtubeVerifiedAt  DateTime?
  tiktokFollowers    Int?
  tiktokVerifiedAt   DateTime?

  // 활동 지표
  heartCount   Int      @default(0)
  trustGrade   String   @default("BRONZE")
  point        Int      @default(0)

  // 출석체크
  attendStreak Int      @default(0)
  lastAttendAt DateTime?

  // 친구 초대
  referralCode String   @unique @default(cuid())
  referredById String?
  referrer     User?    @relation("Referral", fields: [referredById], references: [id])
  referrals    User[]   @relation("Referral")

  // 광고주 검색 노출 동의 (기본 ON, 마이페이지에서 OFF 가능)
  publicProfile Boolean @default(true)

  createdAt    DateTime @default(now())

  applications Application[]
  reviews      Review[]
  penalties    Penalty[]
  reports      Report[]
  snsVerifications SnsVerification[]
  favorites    Favorite[]
  pointHistory PointHistory[]
  redeems      Redeem[]
  advRatings   AdvertiserRating[]
  receivedInvites DirectInvite[]
}

// 광고주 회원
model Advertiser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  companyName  String
  bizNumber    String
  contactName  String
  phone        String
  point        Int      @default(0)  // 캠페인 등록용 포인트
  createdAt    DateTime @default(now())

  campaigns Campaign[]
  pointHistory AdvertiserPointHistory[]
  ratings   AdvertiserRating[]
  members   AdvertiserMember[]
  sentInvites DirectInvite[]
}

// 직접 초대 (광고주 → 인플루언서)
model DirectInvite {
  id           String   @id @default(cuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  title        String
  message      String
  offerSummary String?
  status       String   @default("PENDING")
  expiresAt    DateTime?
  respondedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, status])
  @@index([advertiserId])
}

// 광고주 포인트 내역 (충전/차감)
model AdvertiserPointHistory {
  id           String   @id @default(cuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  delta        Int      // +충전 / -차감
  reason       String   // CHARGE, CAMPAIGN_OPEN, REFUND
  balance      Int      // 처리 후 잔액
  note         String?
  campaignId   String?
  createdAt    DateTime @default(now())

  @@index([advertiserId, createdAt])
}

// 캠페인
model Campaign {
  id            String   @id @default(cuid())
  advertiserId  String
  advertiser    Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  title         String
  description   String     // 풍부한 설명 (마크다운/줄바꿈)
  thumbnail     String     // URL
  type          String     // VISIT, DELIVERY, PURCHASE, REPORTER
  channel       String     // BLOG, INSTA, YOUTUBE, SHORTS, CLIP
  category      String     // 맛집, 카페, 뷰티, 패션, 식품, 생활, 디지털, 여행, 육아
  region        String?    // 서울 강남구 등 (방문형일 때)
  address       String?

  offer         String     // 제공 내역 텍스트 (예: 10만원 상당 코스 요리)
  offerValue    Int        // 제공 가치 금액(원)
  capacity      Int        // 모집 인원
  appliedCount  Int        @default(0)

  applyStart    DateTime
  applyEnd      DateTime
  announceAt    DateTime
  reviewStart   DateTime
  reviewEnd     DateTime

  guide         String     // 미션/가이드 텍스트
  keywords      String     // 필수 키워드 (콤마)
  tags          String     @default("")
  status        String     @default("OPEN") // DRAFT, SCHEDULED, OPEN, CLOSED, COMPLETED
  fastMatch     Boolean    @default(false)
  publishAt     DateTime?  // 예약 발행 시간 (SCHEDULED일 때)

  createdAt     DateTime   @default(now())

  applications  Application[]
  reviews       Review[]
  favorites     Favorite[]
  ratings       AdvertiserRating[]
  invites       DirectInvite[]
}

// 광고주 팀 멤버 (서브 계정 초대)
model AdvertiserMember {
  id           String   @id @default(cuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  email        String
  role         String   @default("MEMBER") // OWNER, MANAGER, MEMBER
  status       String   @default("INVITED") // INVITED, ACTIVE, REVOKED
  invitedAt    DateTime @default(now())
  joinedAt     DateTime?

  @@unique([advertiserId, email])
  @@index([advertiserId])
}

// 매거진 글 (관리자가 작성)
model Article {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String
  body         String   // 마크다운 가능
  coverImage   String
  authorName   String
  category     String   @default("TIPS") // TIPS, NEWS, CASE
  publishedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([publishedAt])
}

// 신청 내역
model Application {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelUrl  String   // 신청자가 활동할 채널 URL
  message     String?  // 자기소개/어필
  status      String   @default("PENDING") // PENDING, SELECTED, REJECTED, COMPLETED, CANCELED
  createdAt   DateTime @default(now())

  review      Review?
  @@unique([campaignId, userId])
}

// 리뷰
model Review {
  id            String   @id @default(cuid())
  applicationId String   @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  url           String
  rating        Int?     // 1~5점 (사용자 자체 평가)
  highlight     String?  // 추천 한 줄 (후기 갤러리 노출)
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason  String?
  bodySnippet   String?
  keywordCheck  String?
  missingKeys   String?
  createdAt     DateTime @default(now())
}

// 패널티
model Penalty {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // CANCEL_AFTER_SELECT, NO_REVIEW, BAD_REVIEW
  reason    String
  point     Int      // 차감 포인트
  createdAt DateTime @default(now())
}

// 신고 - 사용자가 캠페인/광고주 신고
model Report {
  id             String   @id @default(cuid())
  reporterUserId String
  reporter       User     @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  campaignId     String?
  reason         String   // SPAM, FALSE_INFO, BAD_TREATMENT, OTHER
  detail         String
  status         String   @default("OPEN") // OPEN, RESOLVED, REJECTED
  adminNote      String?
  createdAt      DateTime @default(now())

  @@index([status])
}

// SNS 인증샷 업로드
model SnsVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   // blog, insta, youtube, tiktok
  url       String
  metric    Int      // 사용자가 주장한 수치
  imageData String   // data URL (base64) - 인증샷
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?

  @@index([status])
  @@index([userId, channel])
}

// 포인트 내역
model PointHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String   // REVIEW_APPROVED, PENALTY, SIGNUP_BONUS, MANUAL, REDEEM
  balance   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// 포인트샵 - 교환 가능 상품
model RedeemItem {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String
  cost        Int      // 필요 포인트
  stock       Int      @default(100)
  category    String   // GIFTCARD, COUPON, BADGE
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  redeems Redeem[]
}

// 포인트 교환 내역
model Redeem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      RedeemItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cost      Int
  code      String   // 발급 코드 (mock 16자리)
  status    String   @default("ISSUED") // ISSUED, USED, REFUNDED
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// 광고주 평점 (캠페인 완료자가 광고주 평가)
model AdvertiserRating {
  id           String   @id @default(cuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating       Int      // 1~5
  comment      String?
  createdAt    DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([advertiserId])
}

// 즐겨찾기 (관심 캠페인)
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([userId])
}

// 알림 - role + recipientId 폴리모픽 구조
model Notification {
  id          String   @id @default(cuid())
  role        String   // USER | ADVERTISER
  recipientId String
  title       String
  body        String
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([role, recipientId, read])
}
